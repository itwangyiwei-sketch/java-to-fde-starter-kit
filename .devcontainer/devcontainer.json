{
  "name": "Java to FDE Starter Kit",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": false,
      "version": "3.11"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-python.python"
      ],
      "settings": {
        "java.compile.nullAnalysis.mode": "automatic"
      }
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "mvn test-compile"
}
